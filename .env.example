# NeuroCad .env
# All settings are optional. Defaults are in config.py.

# ============================================
# APPLICATION
# ============================================

# Application host (default: 127.0.0.1)
APP_HOST=127.0.0.1

# Application port (default: 8000)
APP_PORT=8000

# Debug mode (default: True)
DEBUG=True

# ============================================
# DATABASE
# ============================================

# Async SQLite URL (used by the app)
SQLITE_URL=sqlite+aiosqlite:///base/neurocad.db

# Sync SQLite URL (used by Alembic migrations)
SQLITE_URL_SYNC=sqlite:///base/neurocad.db

# ============================================
# SECURITY
# ============================================

# Secret key for JWT tokens. CHANGE IN PRODUCTION!
SECRET_KEY=change-me-in-production

# JWT algorithm (default: HS256)
ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# SUPERADMIN
# ============================================

# Default superadmin login (created on first run)
SUPERADMIN_LOGIN=admin

# Default superadmin password (created on first run)
SUPERADMIN_PASSWORD=admin

# ============================================
# USERS
# ============================================

# Auto-create a personal "Каталог статей" nav for every new user.
# When true, every registered user gets their own Nav row pointing
# at the built-in 'default' module, so they immediately have a
# place to create pages.
# Set to false to register users without any nav.
USER_AUTO_CREATE_NAV=1

# ============================================
# PATHS (relative to cwd)
# ============================================

# Media files directory (default: media)
# MEDIA_PATH=media

# Database directory (default: base)
# BASE_PATH=base

# Static files directory (default: static)
# STATIC_PATH=static

# Logs directory (default: log)
# LOG_PATH=log

# ============================================
# DOMAINS / CADDY
# ============================================

# Public IP of this server. Shown in the DNS instructions on the
# "Custom domain" page. If empty — auto-detected via a UDP socket
# trick (works without a real DNS resolver).
# NEUROCAD_PUBLIC_IP=

# Caddy's certificate storage directory. The lazy cleanup removes
# `domains/<name>/` from here when a custom domain has been
# disconnected for more than DOMAIN_GRACE_DAYS.
# Default: /root/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory
# CADDY_CERT_DIR=/root/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory

# Grace period (in days) between disconnecting a custom domain and
# physically deleting its Caddy certificate. Protected system
# domains (`neurocad.ru`, `neurocad-dev.ru`, `neurocad-demo.ru`
# and their subdomains) are never deleted.
# DOMAIN_GRACE_DAYS=30

# ============================================
# LLM
# ============================================

# Active provider: deepseek | openai | yandex | gigachat | gemini
LLM_PROVIDER=deepseek

LLM_MOCK=1

# Secret key for encrypting API keys stored in the database.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable DB-stored secrets (fall back to .env only).
NEUROCAD_SECRET_KEY=

# --- DeepSeek ---

# API key (get it at https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# API base URL (default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model name (default: deepseek-flash)
DEEPSEEK_MODEL=deepseek-flash

# Max output tokens (default: 12000)
DEEPSEEK_MAX_OUTPUT_TOKENS=12000

# Request timeout in seconds (default: 150)
DEEPSEEK_TIMEOUT=150

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_OUTPUT_TOKENS=4096
# OPENAI_TIMEOUT=120

# --- YandexGPT ---
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt-lite
# YANDEX_MAX_OUTPUT_TOKENS=4096
# YANDEX_TIMEOUT=120

# --- GigaChat ---

# Authorization Key from Sber Studio.
# Paste exactly as given — the provider detects the format
# (base64(client_id:client_secret) or "client_id:client_secret").
# GIGACHAT_AUTH_KEY=

# OAuth scope (default: GIGACHAT_API_PERS)
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Model name (default: GigaChat-2-Lite)
# GIGACHAT_MODEL=GigaChat-2-Lite

# Max output tokens (default: 8192)
# GIGACHAT_MAX_OUTPUT_TOKENS=8192

# Request timeout in seconds (default: 120)
# GIGACHAT_TIMEOUT=120

# Russian Trusted Root CA (PEM text). Optional — only needed if the
# system trust store does not include the Ministry of Digital
# Development root CA. Leave empty to use system defaults.
# GIGACHAT_CA_PEM=

# --- Google Gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_TIMEOUT=120