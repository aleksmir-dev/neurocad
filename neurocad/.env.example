# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_MAX_OUTPUT_TOKENS=4096
# GIGACHAT_TIMEOUT=120

# --- Google Gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_TIMEOUT=120